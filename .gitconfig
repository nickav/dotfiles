[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
	pager = less -FXe
	whitespace = cr-at-eol
[user]
	name = Nick Aversano
	email = nick23hi@gmail.com
[alias]
	a = add
	aa = add .
	am = commit --amend
	amend = commit --amend -C HEAD
	b = branch
	br = branch
	c = checkout
	ca = commit -a -m
	ci = commit -m
	cm = commit -m
	co = checkout
	count = rev-list --all --count
  day = diff --shortstat '@{1 day ago}'
  week = diff --shortstat '@{1 week ago}'
	log-day = log --since '1 day ago' --oneline --author nick23hi@gmail.com
	log-week = log --since '1 week ago' --oneline --author nick23hi@gmail.com
  logs = log --pretty=oneline
	dc = diff --cached
	dd = reset HEAD --
	di = checkout --
	discard = checkout --
	ds = diff --staged
	graph = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	last = log -1 HEAD
	master-alias = symbolic-ref refs/heads/m refs/heads/master
	me = "!git log --author=\"$(git config user.name)\""
  month = "!git log --author=\"$(git config user.name)\" --since=\"1 month ago\" --oneline"
	oc = checkout
	review = remote update -p
	s = status
	st = status
  sync = "!git stash && git pull && git stash pop"
  pub = "!git stash && git checkout master && git pull && git checkout - && git rebase master && git checkout master && git merge - && git push && git checkout -"
	undo = reset --soft HEAD^
	unstage = reset HEAD --
	untrack = git rm --cached
	up = "!git remote update -p; git merge --ff-only @{u}"
	us = reset HEAD --
  code = "!git diff $(git rev-list --max-parents=0 HEAD)"
  squash = merge --squash
  squash-all = "!git reset --soft $(git merge-base master HEAD)"
  sync-upstream = "!git fetch --all && git checkout main && git pull && git merge upstream/main && git push origin main && git push upstream main"
[color]
	diff = auto
[push]
	default = simple
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Users/nick/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/nick/.stCommitMsg
[http]
	sslVerify = true
	sslBackend = openssl
#[url "git@github.com:"]
#	insteadOf = https://github.com/
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
#[credential]
#	helper = osxkeychain
[init]
	defaultBranch = main
[safe]
	director = public
	directory = /p/public
	directory = *
	directory = /p/public
