<snippet>
    <content><![CDATA[@echo off

set project_root=%~dp0%
set build_folder=%project_root%\build\

set "time="
if exist "C:\apps\ntime.exe" set "time=C:\apps\ntime.exe"

if not exist %build_folder% (mkdir %build_folder%)
pushd %build_folder%
    ${0}
    %time% odin build ../src -out:main.exe -subsystem:windows -debug || goto :error
    %time% .\main.exe || goto :error
popd

exit /B 0

:error
set "err=%errorlevel%"
popd
exit /B %err%]]></content>
    <tabTrigger>build</tabTrigger>
    <scope>source.dosbatch</scope>
    <description>template for build.bat files</description>
</snippet>
