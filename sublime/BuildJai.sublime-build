{
  "windows": {
    "cmd": ["cmd", "/k", "$folder/build.bat"],
    "keyfiles": ["build.bat"],
    "syntax": "Batch File.sublime-syntax",
    "working_dir": "$folder",
    "file_regex": "^(.+):(\\d+),(\\d+):\\s\\w+:\\s([^\n]+)"
  },
  "osx": {
    "cmd": ["bash", "$folder/build.sh"],
    "keyfiles": ["build.sh"],
    "syntax": "Bash.sublime-syntax",
    "working_dir": "$folder",
    "file_regex": "^(.+):(\\d+),(\\d+):\\s\\w+:\\s(.+)$"
  },
  "linux": {
    "cmd": ["bash", "$folder/build.sh"],
    "keyfiles": ["build.sh"],
    "syntax": "Bash.sublime-syntax",
    "working_dir": "$folder",
    "file_regex": "^(.+):(\\d+),(\\d+):\\s\\w+:\\s(.+)$"
  }
}